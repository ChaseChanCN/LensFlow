# ============================================
# LensFlow Backend Environment Configuration
# ============================================
# Copy to .env and fill in actual values

# --- Application ---
APP_NAME=LensFlow
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# SQLite for local dev, PostgreSQL for production
DB_TYPE=sqlite
# SQLite path (relative to backend dir)
DB_SQLITE_PATH=storage_local/lensflow.db
# PostgreSQL config (used when DB_TYPE=postgresql)
DB_PG_HOST=localhost
DB_PG_PORT=5432
DB_PG_USER=lensflow
DB_PG_PASSWORD=changeme
DB_PG_NAME=lensflow
DB_PG_DRIVER=asyncpg

# --- Security ---
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Storage ---
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=storage_local/uploads
# JPEG processing safety limits (preview <=1024; export keeps oriented dimensions)
IMAGE_MAX_BYTES=20971520
IMAGE_MAX_PIXELS=24000000
IMAGE_MAX_DIMENSION=12000

# --- Notification ---
NOTIFIER_CHANNEL=bark
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=
WECHAT_WORK_WEBHOOK_URL=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
