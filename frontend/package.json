{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:effects": "tsc -b && vite build --config vite.effects.config.ts",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:motion": "node scripts/check-particle-motion.mjs",
    "check:contrast": "node scripts/check-token-contrast.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "test:ui": "vitest run --config vitest.design-system.config.ts",
    "test:ui:coverage": "vitest run --config vitest.design-system.config.ts --coverage",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "3.14.21",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "border-beam": "1.4.1",
    "dayjs": "^1.11.23",
    "liquid-gooey": "0.2.2",
    "metal-fx": "2.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "thinking-orbs": "0.3.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.4"
  }
}
